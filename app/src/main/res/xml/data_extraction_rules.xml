<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Listing include paths restricts backup to these files only, so no databases,
             caches, tokens, session stores or updater state are ever backed up. -->
        <include domain="sharedpref" path="rhythm_preferences.xml" />
        <include domain="sharedpref" path="pico_music_preferences.xml" />
    </cloud-backup>

    <device-transfer>
        <!-- Include preferences for device-to-device migration, excluding temporary/token stores -->
        <include domain="sharedpref" path="rhythm_preferences.xml" />
        <include domain="sharedpref" path="pico_music_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
