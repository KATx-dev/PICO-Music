<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude internal database files -->
        <exclude domain="database" path="rhythm_database" />
        <exclude domain="database" path="rhythm_database-shm" />
        <exclude domain="database" path="rhythm_database-wal" />
        <exclude domain="database" path="pico_music_database" />
        <exclude domain="database" path="pico_music_database-shm" />
        <exclude domain="database" path="pico_music_database-wal" />

        <!-- Exclude caches -->
        <exclude domain="root" path="cache" />
        <exclude domain="root" path="code_cache" />

        <!-- Exclude credentials, tokens, extension configs, and updater state -->
        <exclude domain="sharedpref" path="streaming_service_sessions.xml" />
        <exclude domain="sharedpref" path="pico_extensions.xml" />
        <exclude domain="sharedpref" path="innertube_session.xml" />
        <exclude domain="sharedpref" path="app_updater_downloads.xml" />
        <exclude domain="sharedpref" path="spotify_token_prefs.xml" />

        <!-- Include user preferences and settings -->
        <include domain="sharedpref" path="rhythm_preferences.xml" />
        <include domain="sharedpref" path="pico_music_preferences.xml" />
    </cloud-backup>

    <device-transfer>
        <!-- Include preferences for device-to-device migration, excluding temporary/token stores -->
        <include domain="sharedpref" path="rhythm_preferences.xml" />
        <include domain="sharedpref" path="pico_music_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
