            android:strokeLineCap="round" />

        <!-- Expressive squircle backing glow -->
        <path
            android:pathData="M 116,66 L 284,66 A 50,50 0 0 1 334,116 L 334,284 A 50,50 0 0 1 284,334 L 116,334 A 50,50 0 0 1 66,284 L 66,116 A 50,50 0 0 1 116,66 Z"
            android:fillAlpha="0.18">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="66"
                    android:startY="66"
                    android:endX="334"
                    android:endY="334"
                    android:startColor="#7C5CFF"
                    android:endColor="#2EE6D6" />
            </aapt:attr>
        </path>

        <!-- Primary geometric P stem & acoustic loop -->
        <path
            android:pathData="M 124,296 L 124,118 C 124,104 135,94 149,94 L 214,94 C 266,94 298,125 298,169 C 298,213 266,244 214,244 L 166,244 L 166,296 C 166,308 157,316 145,316 C 133,316 124,308 124,296 Z M 166,134 L 166,204 L 212,204 C 239,204 256,190 256,169 C 256,148 239,134 212,134 Z">
            <aapt:attr name="android:fillColor">
