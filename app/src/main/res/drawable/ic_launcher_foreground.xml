                    android:type="linear"
                    android:startX="124"
                    android:startY="94"
                    android:endX="298"
                    android:endY="310"
                    android:startColor="#FFFFFF"
                    android:centerColor="#D8D2FF"
                    android:endColor="#73F0E8" />
            </aapt:attr>
        </path>

        <!-- Inner play-prism accent inside P aperture -->
        <path
            android:pathData="M 192,150 C 192,146 196,144 200,146 L 228,164 C 231,166 231,172 228,174 L 200,192 C 196,194 192,192 192,188 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="192"
                    android:startY="145"
                    android:endX="230"
                    android:endY="192"
                    android:startColor="#FF8FB1"
                    android:endColor="#64E9FF" />
            </aapt:attr>
        </path>

        <!-- Three ascending soundwave equalizer bars under P arc -->
        <path
            android:pathData="M 196,274 L 196,302"
            android:strokeWidth="20"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="196"
                    android:startY="274"
                    android:endX="196"
                    android:endY="302"
                    android:startColor="#A78BFA"
                    android:endColor="#64D2FF" />
            </aapt:attr>
        </path>

        <path
            android:pathData="M 234,258 L 234,302"
            android:strokeWidth="20"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="234"
                    android:startY="258"
                    android:endX="234"
                    android:endY="302"
                    android:startColor="#38E8D9"
                    android:endColor="#7C5CFF" />
            </aapt:attr>
        </path>

        <path
            android:pathData="M 272,278 L 272,302"
            android:strokeWidth="20"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="272"
                    android:startY="278"
                    android:endX="272"
                    android:endY="302"
                    android:startColor="#FF8FB1"
                    android:endColor="#A78BFA" />
